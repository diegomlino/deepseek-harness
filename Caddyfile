{
	admin off
	auto_https off
	persist_config off
}

:7860 {
	basic_auth {
		{$GATEWAY_AUTH_USER} {$GATEWAY_AUTH_HASH}
	}

	reverse_proxy 127.0.0.1:3080 {
		# Preserva exatamente o Host usado pelo navegador.
		#
		# Público:
		# deepseek.iaengenharia.ia.br
		#
		# Túnel SSH:
		# 127.0.0.1:7860
		header_up Host {hostport}

		# A autenticação Basic pertence somente ao Caddy.
		# Não encaminhar Authorization ao Harness.
		header_up -Authorization
	}
}